MARRIAGE_OCR_LOG_LEVEL=INFO
MARRIAGE_OCR_LOG_DIR=logs
MARRIAGE_OCR_ERROR_DIR=logs/error_reports
MARRIAGE_OCR_OCR_ENGINE=google_vision
MARRIAGE_OCR_REVIEW_EXPORT_PATH=data/reviewed_exports/daftar_perkahwinan_reviewed.xlsx
MARRIAGE_OCR_TRAINING_OUTPUT_DIR=data/ground_truth
MARRIAGE_OCR__INPUT__PDF_DPI=250
MARRIAGE_OCR__TRAINING_EXPORT__VALIDATION_RATIO=0.20

# PostgreSQL connection settings for src/marriage_ocr/db_postgres.py
# Use DATABASE_URL for the common case, or the discrete DATABASE_* fields if
# your password contains reserved characters such as @ or #.
DATABASE_URL=postgresql://postgres:password@localhost:5432/marriagedb
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=marriagedb
DATABASE_USER=postgres
DATABASE_PASSWORD=password
